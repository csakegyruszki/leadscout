# Required: ONE working LLM endpoint - any of the providers below. Model ids are
# provider-prefixed, and a chain may mix them freely (a hop that fails or times out
# falls through to the next entry):
#   openrouter:<id>   OPENROUTER_API_KEY            (the default when no prefix is given)
#   cloudflare:<id>   CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN
#   ollama:<id>       no key at all - a local daemon, set OLLAMA_HOST to move it
#   anthropic:<id>    ANTHROPIC_API_KEY             (native Messages API) + optional
#                     ANTHROPIC_BASE_URL if you front it with a proxy
#   gemini:<id>       GEMINI_API_KEY                (native generateContent API) + optional
#                     GEMINI_BASE_URL if you front it with a proxy
#   openai:<id>       LEADSCOUT_LLM_BASE_URL + optional LEADSCOUT_LLM_API_KEY - anything
#                     else speaking that request shape (Groq, Together, vLLM, LM Studio)
# LEADSCOUT_PROFILE picks a default chain ("demo" = latency-first for a live demo,
# "batch" = free-first for a nightly job); LEADSCOUT_MODELS overrides either profile.
# NOTE: the variable is LEADSCOUT_MODELS (plural) - LEADSCOUT_MODEL is not read and
# only warns, it does not silently activate a single model.
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
OLLAMA_HOST=
LEADSCOUT_LLM_BASE_URL=
LEADSCOUT_LLM_API_KEY=
LEADSCOUT_PROFILE=demo
LEADSCOUT_MODELS=
# A hop exceeding this many seconds is abandoned and the next model in the chain is
# tried; the existing fixed-backoff retry still applies only to the LAST model.
LEADSCOUT_LLM_HOP_TIMEOUT=30

# Optional: real sanctions/PEP screening via the OpenSanctions match API. Without it,
# compliance.screen still runs (fuzzy pre-screen + LLM) but sanctions_status is "skipped".
OPENSANCTIONS_API_KEY=

# Optional: raises the GitHub unauthenticated rate limit (60/hour); providers/github.py
# works fine without it, just with a smaller MAX_CALLS budget margin.
GITHUB_TOKEN=

# Optional: providers/vendor.py's discovery queries. Without it they are skipped
# entirely (no key -> no Brave call -> status="skipped", never "degraded").
BRAVE_API_KEY=

# Optional headcount source (Diffbot Knowledge Graph); see providers/headcount.py.
DIFFBOT_TOKEN=

# Optional: Hunter.io contact-quality check (email-verifier + domain-search).
# Informational only - never affects fit score, cloud usage, or compliance status.
# Without it, providers/hunter.py is skipped entirely (no key -> no call).
HUNTER_API_KEY=

# Where the notification goes (a test inbox).
SALES_REP_EMAIL=sales-rep@example.test

# Optional: real SMTP delivery. Sending is OFF unless LEADSCOUT_SEND_EMAIL is on;
# without it (or with empty SMTP_*) mail is only written as .eml files under out/.
LEADSCOUT_SEND_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# footprint.py's crt.sh/DoH/RIPEstat/range-file crawl over many subdomains fans out
# to dozens of HTTP calls for a single lead; this caps it.
LEADSCOUT_MAX_HTTP_CALLS=60

# Minimum fit_score (of 100) for sales_ready, alongside compliance=clear and
# fit_confidence != LOW. Note: no LEADSCOUT_ prefix, unlike the other tunables above.
FIT_THRESHOLD=60

# Cosmetic build identifier surfaced by GET /health - not read anywhere else.
LEADSCOUT_BUILD=

# Optional: "1" enables the Crawl4AI JS-render escalation in providers/website.py
# when a page looks like an empty JS shell. Any other value (including unset) is
# treated as disabled - Crawl4AI must also be installed for it to actually fire.
LEADSCOUT_JS_RENDER=

# Proof builds only: makes network e-mail delivery impossible in code, whatever the SMTP
# settings above say. The run still writes every .eml file to out/outbox/.
# On: 1 / true / yes / on. Off: empty / 0 / false / no / off. Case does not matter, and
# anything else is a configuration error rather than a silently disabled safety flag -
# "LEADSCOUT_PROOF_MODE=treu" must not leave the refusal off while you believe it is on.
LEADSCOUT_PROOF_MODE=

# Optional: override the outbound User-Agent, e.g. to add a contact URL that resolves.
LEADSCOUT_USER_AGENT=

# Inbound e-mail (docs/inbound-email.md). IMAP poller: leave HOST empty to disable it.
# Use an app password, never the account password. Defaults: PORT 993, FOLDER INBOX,
# MAX_PER_POLL 25; PROCESSED_FOLDER (optional) is where a handled mail is moved.
LEADSCOUT_IMAP_HOST=
LEADSCOUT_IMAP_PORT=
LEADSCOUT_IMAP_USER=
LEADSCOUT_IMAP_PASSWORD=
LEADSCOUT_IMAP_FOLDER=
LEADSCOUT_IMAP_PROCESSED_FOLDER=
LEADSCOUT_IMAP_MAX_PER_POLL=
# Webhook POST /inbound/mail: unset = the endpoint answers 404. Generate a long random value.
LEADSCOUT_INBOUND_TOKEN=
# Raw message size cap in bytes (default 10485760).
LEADSCOUT_INBOUND_MAX_BYTES=
# Concurrent pipeline runs for inbound mail (default 1) and failed attempts before a message
# becomes dead_letter (default 3).
LEADSCOUT_INBOUND_CONCURRENCY=
LEADSCOUT_INBOUND_MAX_ATTEMPTS=
# Sending a reply draft needs this AND LEADSCOUT_SEND_EMAIL AND SMTP_* AND LEADSCOUT_PROOF_MODE off.
LEADSCOUT_SEND_REPLIES=
